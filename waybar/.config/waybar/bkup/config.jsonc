/* 
# ---------------------------------------
# cybr-waybar     waybar config (part of cybrcore)
# Project:        https://github.com/cybrcore/cybr-waybar
# Author:         scherrer-txt   |   License:     GPL-3.0
# Source:         ~/.config/waybar/config.jsonc
# ---------------------------------------
*/
[
	/* BAR 1
	Left:  Powermenu, workspaces
	Mid:   Date, Music, Time
	Right: Network, Keyboard Layout, Audio */
	{
		"include": "~/.config/waybar/modules.jsonc",
		"height": 31,
		"layer": "top",
		"output": "DP-1",
		"mode": "dock",
		"exclusive": true,
		"passtrough": false,
		"gtk-layer-shell": true,
		"margin-top": 0,
		"margin-left": 0,
		"margin-bottom": 0,
		"margin-right": 0,
		"on-scroll-threshold": 1,
		"modules-left": [
			"custom/fedora",
			"custom/arrow-left-re0",
			"sway/workspaces",
			"custom/arrow-left-no1"
			// "custom/updates"
		],
		"modules-center": [
			"custom/arrow-right-no1",
			"clock#date",
			"custom/arrow-right-gr0",
			"mpd",
			"custom/arrow-left-gr0",
			"clock#time",
			"custom/arrow-left-no1"
		],
		"modules-right": [
			"custom/arrow-right-no1",
			"network",
			"sway/language",
			"pulseaudio"
		]
	}
	/* BAR 2
	Left:  Powermenu, workspaces
	Mid:   Date, Current Window, Time
	Right: RAM, GPU, CPU, Brightness, Notifications, Tray */
	,{
		"include": "~/.config/waybar/modules.jsonc",
		"height": 31,
		"layer": "top",
		"output": "DP-2",
		"mode": "dock",
		"exclusive": true,
		"passtrough": false,
		"gtk-layer-shell": true,
		"margin-top": 0,
		"margin-left": 0,
		"margin-bottom": 0,
		"margin-right": 0,
		"on-scroll-threshold": 1,
		"modules-left": [
			"custom/fedora",
			"custom/arrow-left-re0",
			"sway/workspaces",
			"custom/arrow-left-no1"
		],
		"modules-center": [
			"custom/arrow-right-no1",
			"clock#date",
			"custom/arrow-right-re0",
			"sway/window",
			"custom/arrow-left-re0",
			"clock#time",
			"custom/arrow-left-no1"
		],
		"modules-right": [
			"custom/arrow-right-no1",
			"memory",
			/* nvidia は GPU 面倒なため省略
			"temperature#gpu",
			*/
			"temperature#cpu",
			"custom/brightness", /*memo 輝度調整はここを消せばよい？*/
			// "custom/notifications",
			"tray"
		]
	}
]
