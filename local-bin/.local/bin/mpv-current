#!/usr/bin/env zsh

SOCK="$HOME/.cache/mpv-music.sock"

[ -S "$SOCK" ] || exit 0

json="$(
  printf '{ "command": ["get_property", "metadata"] }\n' \
    | socat - "$SOCK" 2>/dev/null
)"

[ -n "$json" ] || exit 0

title="$(
  printf '%s\n' "$json" \
    | jq -r '.data.title // .data.TITLE // empty'
)"

artist="$(
  printf '%s\n' "$json" \
    | jq -r '.data.artist // .data.ARTIST // .data.album_artist // .data.ALBUM_ARTIST // empty'
)"

if [ -n "$title" ] && [ -n "$artist" ]; then
  printf '%s - %s\n' "$artist" "$title"
elif [ -n "$title" ]; then
  printf '%s\n' "$title"
else
  # タグが無い場合だけ media-title に fallback
  printf '{ "command": ["get_property", "media-title"] }\n' \
    | socat - "$SOCK" 2>/dev/null \
    | jq -r '.data // empty'
fi

