#!/usr/bin/env bash

CONTAINER="kali-lab"

SCRIPT_DIR="$HOME/.local/bin"
KALI_SCRIPT="$SCRIPT_DIR/rofi-command-kali"
FEDORA_SCRIPT="$SCRIPT_DIR/rofi-command-fedora"


# ==================================================
# 実行対象を判定
# ==================================================

case "$(basename "$0")" in
    rofi-command-kali)
        TARGET="kali"
        TARGET_NAME="Kali"
        ;;

    rofi-command-fedora)
        TARGET="fedora"
        TARGET_NAME="Fedora"
        ;;

    *)
        TARGET=""
        ;;
esac


# ==================================================
# rofi本体を起動
# ==================================================

# Swayなどから rofi-command を直接呼んだ場合
if [[ -z "${ROFI_RETV+x}" ]]; then

    exec rofi \
        -show Kali \
        -modes "Kali:$KALI_SCRIPT,Fedora:$FEDORA_SCRIPT" \
        -sidebar-mode \
        -kb-accept-entry "" \
        -kb-accept-custom "Return" \
        -kb-custom-1 "Control+Return" \
        -theme-str '
            window {
                width: 60%;
            }

            listview {
                lines: 12;
                fixed-height: false;
                dynamic: true;
                scrollbar: true;
            }
        '
fi


# ==================================================
# 共通処理
# ==================================================

print_header() {
    printf '\0prompt\x1f%s > \n' "$TARGET_NAME"
    printf '\0no-custom\x1ffalse\n'
    printf '\0use-hot-keys\x1ftrue\n'
}


print_output_line() {
    local line="$1"

    [[ -z "$line" ]] && line=" "

    printf '%s\0nonselectable\x1ftrue\x1fpermanent\x1ftrue\n' "$line"
}


get_command() {
    if [[ -n "${ROFI_INPUT:-}" ]]; then
        printf '%s' "$ROFI_INPUT"
    else
        printf '%s' "${1:-}"
    fi
}


# ==================================================
# rofiから呼ばれたとき
# ==================================================

case "${ROFI_RETV:-0}" in

    # ----------------------------------------------
    # 初回表示
    # ----------------------------------------------
    0)
        print_header

        if [[ "$TARGET" == "kali" ]]; then
            printf '\0message\x1fKali: %s  |  Enter: run  |  Ctrl+Enter: Alacritty\n' "$CONTAINER"
        else
            printf '\0message\x1fFedora host  |  Enter: run  |  Ctrl+Enter: Alacritty\n'
        fi

        # エントリ0件でrofiが終了しないようにする
        print_output_line " "
        ;;


    # ----------------------------------------------
    # Enter
    # ----------------------------------------------
    2)
        command="$(get_command "$@")"

        print_header

        if [[ -z "${command//[[:space:]]/}" ]]; then
            printf '\0message\x1fEnter a command\n'
            print_output_line " "
            exit 0
        fi


        # --------------------------
        # Kali Distrobox
        # --------------------------
        if [[ "$TARGET" == "kali" ]]; then

            output="$(
                distrobox enter \
                    --name "$CONTAINER" \
                    --no-tty \
                    -- \
                    bash -lc "cd ~ && $command" \
                    2>&1
            )"

            status=$?


        # --------------------------
        # Fedora host
        # --------------------------
        else

            output="$(
                bash -lc "cd ~ && $command" \
                2>&1
            )"

            status=$?

        fi


        printf '\0message\x1f%s  |  exit: %d  |  %s\n' \
            "$TARGET_NAME" \
            "$status" \
            "$command"


        if [[ -n "$output" ]]; then

            while IFS= read -r line || [[ -n "$line" ]]; do
                print_output_line "$line"
            done <<< "$output"

        else
            print_output_line "(no output)"
        fi
        ;;


    # ----------------------------------------------
    # Ctrl+Enter
    #
    # 対話コマンドなどをAlacrittyへ逃がす
    # ----------------------------------------------
    10)
        command="$(get_command "$@")"

        if [[ -z "${command//[[:space:]]/}" ]]; then
            print_header
            printf '\0message\x1fEnter a command\n'
            print_output_line " "
            exit 0
        fi


        # Kali
        if [[ "$TARGET" == "kali" ]]; then

            coproc (
                alacritty \
                    -e \
                    distrobox enter \
                    --name "$CONTAINER" \
                    -- \
                    bash -lc "cd ~ && $command; exec bash" \
                    >/dev/null 2>&1
            )


        # Fedora
        else

            coproc (
                alacritty \
                    -e \
                    bash -lc "cd ~ && $command; exec bash" \
                    >/dev/null 2>&1
            )

        fi

        exit 0
        ;;

esac
