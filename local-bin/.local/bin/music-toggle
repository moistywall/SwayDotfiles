#!/usr/bin/env bash

PIDFILE="$HOME/.cache/music-mpv.pid"
SOCK="$HOME/.cache/mpv-music.sock"
SCRIPT_DIR="$HOME/.local/bin"

if [ -f "$PIDFILE" ]; then
  pid="$(cat "$PIDFILE" 2>/dev/null)"

  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    "$SCRIPT_DIR/music-pause"
    exit 0
  fi
fi

rm -f "$PIDFILE" "$SOCK"

"$SCRIPT_DIR/music-start"
